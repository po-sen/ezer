{
  "name": "@ezer/memory",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "test": "node --test tests/architecture.test.ts && vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.1",
    "@cloudflare/workers-types": "5.20260926.1",
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "24.19.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.143.0"
  }
}
