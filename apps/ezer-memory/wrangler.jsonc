{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezer-memory",
  "main": "src/entrypoints/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_do_not_populate_process_env",
    "global_fetch_strictly_public",
  ],
  "secrets": { "required": [] },
  // Supply deployment-specific, non-secret OAuth policy through trusted configuration.
  // An empty policy keeps /mcp unavailable; /health remains public.
  "vars": { "EZER_AUTHORIZATION": {} },
  // Local emulation needs no account. Set an owned namespace ID before deployment.
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "EZER_MEMORY", "class_name": "EzerMemory" }],
  },
  "exports": {
    "EzerMemory": { "type": "durable-object", "storage": "sqlite" },
  },
}
