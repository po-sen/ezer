{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ezer-memory",
  "main": "src/entrypoints/worker.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": { "required": [] },
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "EZER_MEMORY", "class_name": "EzerMemory" }],
  },
  "exports": {
    "EzerMemory": { "type": "durable-object", "storage": "sqlite" },
  },
}
