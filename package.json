{
  "name": "ezer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "check": "node scripts/check-repository.ts && pnpm -r run check",
    "check:staged": "node scripts/check-staged-paths.ts && lint-staged --config .lintstagedrc.json",
    "format": "prettier --write",
    "format:check": "prettier --check"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9"
  }
}
